# Copy this file to .env and fill in real values.
# .env is gitignored and never committed.

# AI providers — see core/providers.py. Each can also be pasted under
# Settings → Keys, which writes it to ~/scriptorium/.env.
# OpenAI: speech.transcribe (Whisper STT) and telegram.embed_messages.
OPENAI_API_KEY=
# Anthropic: no shipped script uses it yet; photo.ocr will.
ANTHROPIC_API_KEY=

# Telegram — used by util.notify and the run notifications. Both can also be
# pasted under Settings → Keys, which writes them to ~/scriptorium/.env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to 1 to send a Telegram message after every script run, however short.
# Leave empty to let Settings → Notifications decide (opt-in, with a minimum
# run length).
SCRIPTORIUM_NOTIFY=
