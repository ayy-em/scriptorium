# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.ruff_cache/

# pytest
.pytest_cache/

# LLMs
.claude
CLAUDE.md

# IDEs
.cursor/
.vscode/
.idea/

# Virtual environments
.venv/
# uv.lock is intentionally tracked: this repo ships an application, and CI must
# install the exact set that was verified locally. Leaving it ignored let local
# and CI resolutions drift until a clean resolve broke the v0.5.2 release.

# sensitive files
.env
creds.json
tests/telegram/fixtures/chat_export/result.json

# OS
.DS_Store

# Ignore any folder named 'inputs' or 'outputs' and all their contents, anywhere in the repo
inputs/
outputs/
**/inputs/**
**/outputs/**

past_inputs/
*.json

# various media files cause these could go anywhere and i'm paranoid
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.flv
*.m4v
*.mp3
*.wav
*.aac
*.flac
*.ogg
*.m4a
*.wma
*.opus

# and docs
*.pdf
*.docx
*.doc
*.txt
*.xlsx
*.xls
*.csv
*.tsv
archive/
logs/

# Licences for vendored assets must ship with them, despite the *.txt rule above
!**/LICENSE*.txt
!**/OFL.txt
!**/UFL.txt
*.json
